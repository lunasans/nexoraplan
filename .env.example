# Kopieren nach .env und anpassen. Die .env niemals ins Git einchecken!
# Unter NexoraPanel legt das Panel alle Werte selbst an.

# Adresse, auf der die App lauscht (nur ohne systemd-Socket, also lokal)
PLAN_ADDR=127.0.0.1:8090

# Adresse im Browser. Das Sitzungscookie gilt nur für genau diese Adresse.
PLAN_PUBLIC_URL=http://localhost:8090

# MariaDB/MySQL. Pflicht.
#   lokal:  PLAN_DATABASE_DSN=plan:GEHEIM@tcp(127.0.0.1:3306)/nexoraplan
#   Panel:  PLAN_DATABASE_DSN=<user>:<pw>@unix(/run/mysqld/mysqld.sock)/<db>
PLAN_DATABASE_DSN=

# Verschlüsselt das gespeicherte Kalender-Passwort (SOGo) in der Datenbank.
# Erzeugen mit:  go run ./cmd/server genkey
# Geht er verloren, muss nur das Kalender-Passwort neu eingegeben werden.
PLAN_ENCRYPTION_KEY=

# Zeitzone für Woche, Termine und Buchungen
PLAN_TIMEZONE=Europe/Berlin

# Vorschlag für die Kalender-Adresse in den Einstellungen (SOGo des Panels)
PLAN_CALDAV_URL=

# Code für die Ersteinrichtung. Leer = bei jedem Start zufällig, steht im Log.
PLAN_SETUP_CODE=
